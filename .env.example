# Local Postgres Database Password
DB_PASSWORD=

# Shared dev DB stack (docker-compose-dev.yml, run once via `make dev-infra`).
# Every worktree's bot connects to the same instance over these host ports.
DATABASE_URL_POOLED=postgresql://postgres:flyerscord-dev-db@localhost:6432/flyerscord
DATABASE_URL_SINGLE=postgresql://postgres:flyerscord-dev-db@localhost:5433/flyerscord

# Discord Bot Token
DISCORD_TOKEN=

# Encryption Key (use `openssl rand -hex 32` to generate)
ENCRYPTION_KEY=

# Advanced Debug Logging (true/false)
ADVANCED_DEBUG=false

# Comma seperated list of user id that are allowed to manage the bot, like use the bot DM commands
BOT_MANAGERS=
